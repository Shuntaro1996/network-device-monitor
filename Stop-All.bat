@echo off
REM =========================================================================
REM 【初心者向けの簡単な解説】
REM Launcher.ps1 で開いた「機器ごとの監視ウィンドウ」(Monitor-SingleDevice.ps1) を
REM すべてまとめて終了させるためのファイルです。
REM ダブルクリックすると停止の合図 (.stop_signal) を置き、各ウィンドウが
REM 集計結果を保存してから自動で閉じます。
REM ※ メインの監視画面 (Start-Monitor.bat) には影響しません。
REM =========================================================================

setlocal
chcp 932 >nul
cd /d "%~dp0"

type nul > ".stop_signal"
echo 停止の合図を送りました。各監視ウィンドウが集計後に自動で閉じます。
echo (次に Launcher.ps1 を起動すると、合図は自動で取り消されます)
timeout /t 3 >nul 2>&1
