# OS / Editor
desktop.ini
Thumbs.db
.DS_Store
*.swp
*~
.vscode/
.idea/

# Google Drive temp
.tmp.drivedownload/
.tmp.driveupload/

# 機器の一覧と設定 (社内のアドレスや機器名が入るので公開しない。形式は system/devices.example.json を参照)
system/devices.json
system/config.json

# Runtime Generated Reports & Logs
Reports/*
!Reports/.gitkeep

# Temporary / Cache
*.log
*.tmp

# Python
.venv/
__pycache__/
*.pyc

# Agents & Backups
.agents/
system/backups/
system/tests/temp_*


# Machine-specific BOM check cache
system/.bom_cache

# Stop-All.bat が置く一括停止の合図
.stop_signal

# 壊れて読めなかった設定ファイルの退避コピー
system/*.broken_*
